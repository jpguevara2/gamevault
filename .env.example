# Copia este archivo como .env y completa los valores

# Secreto de sesión (cámbialo por cualquier texto largo)
SESSION_SECRET=cambia_esto_por_algo_secreto_largo

# Google OAuth (opcional — si no lo configuras, solo funciona usuario/contraseña)
# Pasos para obtenerlo:
# 1. Ve a https://console.cloud.google.com
# 2. Crea un proyecto nuevo
# 3. Ve a "APIs y servicios" → "Credenciales"
# 4. Crea credenciales → "ID de cliente OAuth 2.0"
# 5. Tipo: Aplicación web
# 6. URI de redireccionamiento: http://localhost:3000/auth/google/callback
# 7. Copia el Client ID y Client Secret aquí

GOOGLE_CLIENT_ID=tu_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
